generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String     @default("Customer")
  mobile       String?    @unique
  email        String?    @unique
  passwordHash String?
  role         String     @default("CUSTOMER") // CUSTOMER | ADMIN
  cartItems    CartItem[]
  orders       Order[]
  addresses    UserAddress[]
  createdAt    DateTime   @default(now())
}

model UserAddress {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  label         String   @default("Home")
  recipientName String
  phone         String
  addressLine   String
  city          String
  state         String
  pincode       String
  buyerGstin    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpVerification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  mobile    String   @unique
  otpHash   String
  expiresAt DateTime
  attemptCount Int    @default(0)
  createdAt DateTime @default(now())
}

model Product {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  
  // Matches the 6 products already in your MongoDB Atlas:
  price       Int?
  quantity    Int?
  category    String?

  // Made optional (?) so existing products don't crash Prisma:
  pricePaise  Int?        // Base price before GST in paise
  gstRate     Int?        @default(18)
  hsnCode     String?     @default("9983")
  imageUrl    String?     // Cloudinary URL
  imageUrls   String[]    @default([])
  mediaType   String?     @default("image")
  stock       Int?        @default(0)
  isDeleted   Boolean?    @default(false)
  createdAt   DateTime?   @default(now())

  cartItems   CartItem[]
  orderItems  OrderItem[]
  coupons     Coupon[]
  inventoryMovements ProductInventoryMovement[]
  weightGrams Int? @default(500) // e.g., 500g = 0.5kg
  lengthCm    Int? @default(10)
  breadthCm   Int? @default(10)
  heightCm    Int? @default(10)
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  quantity  Int      @default(1)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Coupon {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  code             String    @unique
  type             String    // PERCENT | FLAT
  value            Int       
  minOrderPaise    Int       @default(0)
  maxDiscountPaise Int?
  usageLimit       Int?
  usedCount        Int       @default(0)
  expiresAt        DateTime?
  productId        String?   @db.ObjectId // Null = whole cart
  isActive         Boolean   @default(true)
  isVisible        Boolean   @default(true)
  
  product          Product?  @relation(fields: [productId], references: [id])
  orders           Order[]
  createdAt        DateTime  @default(now())
}

model StoreSettings {
  id                  String @id @map("_id")
  shippingChargePaise Int    @default(9900)
  codChargePaise      Int    @default(10000)
  brandName           String @default("Naju's Magic Shop")
  logoUrl             String?
}

model Order {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber         String?
  userId              String      @db.ObjectId
  status              String      @default("PENDING")
  invoiceNumber       String?     // FIX: @unique removed from here

  subtotalPaise       Int
  discountPaise       Int         @default(0)
  taxableAmountPaise  Int
  cgstPaise           Int         @default(0)
  sgstPaise           Int         @default(0)
  igstPaise           Int         @default(0)
  totalGstPaise       Int         @default(0)
  totalAmountPaise    Int
  refundedAmountPaise Int         @default(0)
  refundReason        String?
  refundIds           String[]    @default([])

  recipientName       String
  phone               String
  addressLine         String
  city                String
  state               String
  pincode             String
  buyerGstin          String?
  trackingId          String?

  couponId            String?     @db.ObjectId
  paymentId           String?
  razorpayOrderId     String?
  razorpaySignature   String?
  paymentMethod       String      @default("RAZORPAY")
  paymentInstrument   String?
  paymentReference    String?
  discountIncludesGst Boolean     @default(false)
  checkoutMode        String      @default("CART")
  stockReserved       Boolean     @default(false)
  paidAt              DateTime?
  shippingChargePaise Int         @default(0)
  codChargePaise      Int         @default(0)
  totalWeightKg       Float       @default(0.5)
  shiprocketOrderId   String?
  shipmentId          String?
  awbCode             String? // Tracking number (Air Waybill)
  courierName         String?
  trackingUrl         String?
  cancellationReason  String?

  user                User        @relation(fields: [userId], references: [id])
  coupon              Coupon?     @relation(fields: [couponId], references: [id])
  items               OrderItem[]
  events              OrderEvent[]
  inventoryMovements  ProductInventoryMovement[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([orderNumber])
  @@index([razorpayOrderId])
  @@index([invoiceNumber]) // FIX: Standard index added here
}

model ProductInventoryMovement {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  productId      String   @db.ObjectId
  orderId        String?  @db.ObjectId
  type           String
  quantity       Int
  stockBefore    Int
  stockAfter     Int
  reference      String?
  note           String?
  actor          String   @default("SYSTEM")
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model OrderEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  type      String
  status    String
  message   String
  actor     String   @default("SYSTEM")
  amountPaise      Int?
  paymentMethod    String?
  paymentInstrument String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderSequence {
  id    String @id @map("_id")
  value Int    @default(0)
}

model OrderItem {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId           String  @db.ObjectId
  productId         String  @db.ObjectId
  productName       String
  hsnCode           String
  quantity          Int
  unitPricePaise    Int
  gstRate           Int
  discountPaise     Int     @default(0)
  taxableValuePaise Int
  cgstPaise         Int     @default(0)
  sgstPaise         Int     @default(0)
  igstPaise         Int     @default(0)
  totalPaise        Int

  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id])
}