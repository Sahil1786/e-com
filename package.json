{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "main": "backend/app.js",
  "scripts": {
    "start": "node backend/app.js",
    "admin": "npm --prefix frontend run dev",
    "dev": "node --watch backend/app.js",
    "test": "node --test backend/test/app.test.js backend/test/order-workflow.test.js",
    "routes": "node backend/scripts/listRoutes.js",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema backend/prisma/schema.prisma",
    "db:check": "node backend/scripts/checkDatabase.js",
    "db:push": "prisma db push --schema backend/prisma/schema.prisma",
    "seed": "node backend/prisma/seed.js",
    "studio": "npx prisma studio --schema backend/prisma/schema.prisma"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
