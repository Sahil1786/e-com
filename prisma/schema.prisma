generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String     @default("Customer")
  mobile       String?    @unique
  email        String?    @unique
  passwordHash String?
  role         String     @default("CUSTOMER") // CUSTOMER | ADMIN
  cartItems    CartItem[]
  orders       Order[]
  createdAt    DateTime   @default(now())
}

model OtpVerification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  mobile    String   @unique
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Product {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  
  // Matches the 6 products already in your MongoDB Atlas:
  price       Int?
  quantity    Int?
  category    String?

  // Made optional (?) so existing products don't crash Prisma:
  pricePaise  Int?        // Base price before GST in paise
  gstRate     Int?        @default(18)
  hsnCode     String?     @default("9983")
  imageUrl    String?     // Cloudinary URL
  mediaType   String?     @default("image")
  stock       Int?        @default(0)
  isDeleted   Boolean?    @default(false)
  createdAt   DateTime?   @default(now())

  cartItems   CartItem[]
  orderItems  OrderItem[]
  coupons     Coupon[]
  weightGrams Int? @default(500) // e.g., 500g = 0.5kg
  lengthCm    Int? @default(10)
  breadthCm   Int? @default(10)
  heightCm    Int? @default(10)
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  quantity  Int      @default(1)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Coupon {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  code             String    @unique
  type             String    // PERCENT | FLAT
  value            Int       
  minOrderPaise    Int       @default(0)
  maxDiscountPaise Int?
  usageLimit       Int?
  usedCount        Int       @default(0)
  expiresAt        DateTime?
  productId        String?   @db.ObjectId // Null = whole cart
  isActive         Boolean   @default(true)
  
  product          Product?  @relation(fields: [productId], references: [id])
  orders           Order[]
  createdAt        DateTime  @default(now())
}

model Order {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  userId              String      @db.ObjectId
  status              String      @default("PENDING") // PENDING, PAID, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  invoiceNumber       String?     @unique

  subtotalPaise       Int
  discountPaise       Int         @default(0)
  taxableAmountPaise  Int
  cgstPaise           Int         @default(0)
  sgstPaise           Int         @default(0)
  igstPaise           Int         @default(0)
  totalGstPaise       Int         @default(0)
  totalAmountPaise    Int
  refundedAmountPaise Int         @default(0)
  refundReason        String?

  recipientName       String
  phone               String
  addressLine         String
  city                String
  state               String
  pincode             String
  buyerGstin          String?
  trackingId          String?

  couponId            String?     @db.ObjectId
  paymentId           String?
  paidAt              DateTime?
  shippingChargePaise Int     @default(0)
  totalWeightKg       Float   @default(0.5)
  shiprocketOrderId   String?
  shipmentId          String?
  awbCode             String? // Tracking number (Air Waybill)
  courierName         String?
  trackingUrl         String?

  user                User        @relation(fields: [userId], references: [id])
  coupon              Coupon?     @relation(fields: [couponId], references: [id])
  items               OrderItem[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model OrderItem {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId           String  @db.ObjectId
  productId         String  @db.ObjectId
  productName       String
  hsnCode           String
  quantity          Int
  unitPricePaise    Int
  gstRate           Int
  discountPaise     Int     @default(0)
  taxableValuePaise Int
  cgstPaise         Int     @default(0)
  sgstPaise         Int     @default(0)
  igstPaise         Int     @default(0)
  totalPaise        Int

  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id])
}